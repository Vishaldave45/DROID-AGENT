# NexForge Droid Environment Specification
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# Database Persistence
DATABASE_URL=postgresql://nexforge:nexforge_secret@localhost:5432/nexforge_droid

# Sandbox & Execution Security
WORKSPACE_ROOT=/workspace
SANDBOX_TIMEOUT_SECONDS=120
MAX_EXECUTION_MEMORY_MB=1024
SANDBOX_ENABLE_NETWORK=false

# Agent Limits & Budgets
MAX_ITERATIONS=25
MAX_CONTEXT_TOKENS=32000
AUTO_APPROVE_SAFE_TOOLS=true
